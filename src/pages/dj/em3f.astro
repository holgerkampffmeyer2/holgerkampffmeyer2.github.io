---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import heroImg from '../../assets/img/tomatefestival.jpg';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getDjPersonSchema } from '../../utils/dj-schema.js';

const breadcrumbSegments = [
  { label: "Startseite", href: "/" },
  { label: "DJ Hulk", href: "/djhulk-electronic-music/" },
  { label: "Fotos" }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://holger-kampffmeyer.de/"},
    {"@type": "ListItem", "position": 2, "name": "DJ Hulk", "item": "https://holger-kampffmeyer.de/djhulk-electronic-music/"},
    {"@type": "ListItem", "position": 3, "name": "EM3F Festival", "item": "https://holger-kampffmeyer.de/dj/em3f/"}
  ]
};

const photos = [
  { src: "/img/em3f/DSC_2142.webp", alt: "DJ Hulk EM3F Festival Foto 1" },
  { src: "/img/em3f/DSC_2157.webp", alt: "DJ Hulk EM3F Festival Foto 2" },
  { src: "/img/em3f/DSC_2289.webp", alt: "DJ Hulk EM3F Festival Foto 3" },
  { src: "/img/em3f/DSC_2305.webp", alt: "DJ Hulk EM3F Festival Foto 4" },
  { src: "/img/em3f/DSC_2308.webp", alt: "DJ Hulk EM3F Festival Foto 5" },
  { src: "/img/em3f/DSC_2311.webp", alt: "DJ Hulk EM3F Festival Foto 6" },
  { src: "/img/em3f/DSC_2315.webp", alt: "DJ Hulk EM3F Festival Foto 7" },
  { src: "/img/em3f/DSC_2316.webp", alt: "DJ Hulk EM3F Festival Foto 8" },
  { src: "/img/em3f/DSC_2320.webp", alt: "DJ Hulk EM3F Festival Foto 9" },
  { src: "/img/em3f/DSC_2386.webp", alt: "DJ Hulk EM3F Festival Foto 10" },
  { src: "/img/em3f/DSC_2451.webp", alt: "DJ Hulk EM3F Festival Foto 11" },
  { src: "/img/em3f/DSC_2583.webp", alt: "DJ Hulk EM3F Festival Foto 12" },
  { src: "/img/em3f/UP8A7720.webp", alt: "DJ Hulk EM3F Festival Foto 13" },
  { src: "/img/em3f/UP8A7733.webp", alt: "DJ Hulk EM3F Festival Foto 14" },
  { src: "/img/em3f/UP8A7778.webp", alt: "DJ Hulk EM3F Festival Foto 15" },
  { src: "/img/em3f/UP8A8078.webp", alt: "DJ Hulk EM3F Festival Foto 16" }
];
---

<Layout 
  noSiteJsonLd
   title="DJ Fotos - Electronic Music Family and Friends Festival"
   description="Fotos vom Electronic Music Family and Friends Festival (EM3F). DJ Hulk's Festival-Fotogalerie mit Eindrücken vom Event. Jetzt ansehen und inspirieren lassen!"
  image="/img/tomatefestival.webp"
  jsonLd={[breadcrumbSchema, getDjPersonSchema()]}
>
  <Navbar currentPage="/dj/em3f/" />

  <!-- Breadcrumb -->
  <Breadcrumb segments={breadcrumbSegments} />

  <Hero 
  image={heroImg}
  >
    <div class="max-w-3xl pt-32 text-center">
      <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase animate-fadeInUp">Electronic Music Family and Friends Festival</span>
      <h1 class="font-play text-5xl md:text-7xl font-bold mb-6 gradient-text animate-fadeInUp stagger-2">DJ Fotos</h1>
      <p class="text-[var(--color-text-muted)] text-xl mb-8 max-w-2xl animate-fadeInUp stagger-3">
        Eindrücke von Events und Festivals
      </p>
    </div>
  </Hero>

  <!-- About EM3F -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-play text-3xl font-bold mb-6">Electronic Music Family and Friends Festival</h2>
      <p class="text-[var(--color-text-muted)] mb-4">
        Als Mitgründer des DJ Kollektivs <strong class="text-[var(--color-secondary)]">ToMaTe Stuttgart n.e.V.</strong> organisiere ich Veranstaltungen für Elektronische Musik.
      </p>
      <p class="text-[var(--color-text-muted)]">
        Das jährlich stattfindende <strong class="text-[var(--color-secondary)]">Electronic Music Family and Friends Festival</strong> ist ein Highlight für alle Electronic Music Liebhaber in der Region Stuttgart.
      </p>
    </div>
  </section>

  <!-- Photo Gallery -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Galerie</span>
        <h2 class="font-play text-4xl font-bold mt-4">Event Fotos</h2>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4" id="gallery-grid">
        {photos.map((photo, index) => (
          <div class="aspect-square overflow-hidden rounded-xl animate-on-scroll" style={`animation-delay: ${index * 0.05}s`}>
            <img 
              src={photo.src} 
              alt={photo.alt} 
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover hover:scale-110 transition-transform duration-500 cursor-pointer"
              data-gallery-index={index}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- More Events Link -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="font-play text-3xl font-bold mb-6">Mehr Videos</h2>
      <p class="text-[var(--color-text-muted)] mb-8">
        Schau dir auch meine Videos auf YouTube und die Galerie auf der DJ Hulk Seite an.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://www.youtube.com/@djhulk_de" target="_blank" rel="noopener noreferrer nofollow" class="btn-primary">
          YouTube
        </a>
        <a href="/djhulk-electronic-music/#galerie" class="btn-secondary">
          Video Galerie
        </a>
      </div>
    </div>
  </section>

  <Footer />

  <Lightbox images={photos} />

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('gallery-grid');
      const lightbox = document.getElementById('lightbox');
      
      if (grid && lightbox) {
        const lightboxInstance = lightbox.__lightbox;
        
        grid.addEventListener('click', (e) => {
          const img = e.target.closest('img[data-gallery-index]');
          if (img) {
            const index = parseInt(img.dataset.galleryIndex!);
            lightboxInstance.open(index);
          }
        });
      }
    });
  </script>
</Layout>
