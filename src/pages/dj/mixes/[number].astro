---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import MixDetail from "../../../components/dj/MixDetail.astro";
import { getMixDisplay } from "../../../utils/mix-display.js";
import { getDjPersonSchema } from "../../../utils/dj-schema.js";
import type { BlogPostData } from "../../../types/blog";
import { loadBlogPosts } from "../../../utils/blog-data";
import labelsData from "../../../data/labels.json";
import { buildTrackLabels } from "../../../utils/track-labels.js";
import {
  buildBlogPostingSchema,
  buildAudioObjectSchema,
  buildBreadcrumbSchema,
  buildLabelEntities,
  buildTracklistItemList,
} from "../../../utils/schema-builders.js";

export async function getStaticPaths() {
  const allPosts = await loadBlogPosts();
  const postsWithTracklists = allPosts.filter((post: BlogPostData) => post.hasTracklist);

   return postsWithTracklists.map((post: BlogPostData, index: number) => {
      const currentIndex = index;
      const prevPost = currentIndex < postsWithTracklists.length - 1 ? postsWithTracklists[currentIndex + 1] : null;
      const nextPost = currentIndex > 0 ? postsWithTracklists[currentIndex - 1] : null;
      const isLatest = index === 0;

      return {
         params: { number: post.slug },
        props: { post, prevPost, nextPost, isLatest }
      };
    });
}

interface Props {
  post: BlogPostData;
  prevPost: BlogPostData | null;
  nextPost: BlogPostData | null;
  isLatest: boolean;
}

const { post, prevPost, nextPost, isLatest } = Astro.props;

// Build track labels for this mix
const trackLabels = buildTrackLabels(labelsData);

// Get unique labels for this mix, sorted by frequency
const labelCounts = new Map<string, { name: string; url: string | null; count: number }>();
if (post.tracklist) {
  for (const track of post.tracklist) {
    const label = trackLabels.get(track);
    if (label) {
      const key = label.name;
      const existing = labelCounts.get(key) || { name: label.name, url: label.url, count: 0 };
      existing.count++;
      labelCounts.set(key, existing);
    }
  }
}

// Top labels sorted by count
const topLabels = Array.from(labelCounts.values())
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);

const topLabelNames = topLabels.map(l => l.name);
const topLabelNamesStr = topLabelNames.join(', ');

// Build enhanced title with top labels
const curDisplayLabel = getMixDisplay(post.key, post.title);
const mixPrefix = curDisplayLabel.mixNum ? `Mix#${curDisplayLabel.mixNum} - ` : '';
const baseTitle = `${mixPrefix}${post.title}`;
const enhancedTitle = topLabelNames.length > 0
  ? `${baseTitle} | ${topLabelNames.slice(0, 3).join(', ')}`
  : baseTitle;
const rawTitle = `${enhancedTitle} - DJ Hulk Weekly Mix - House, Tech House, Deep House - Electronic Music`;
const pageTitle = rawTitle.length > 70 ? rawTitle.substring(0, 67).trimEnd() + '…' : rawTitle;

// Enhanced description with top labels and use cases
const useCasesStr = post.useCases?.length ? post.useCases.join(', ') : '';
const baseDesc = `${mixPrefix}${post.title} - Electronic Music Mix with Tracklist. ${topLabelNamesStr ? `Featuring tracks from ${topLabelNamesStr}. ` : ''}${useCasesStr ? `Perfect for ${useCasesStr}. ` : ''}Enjoy House, Tech House, Deep House sets. Free streaming on Mixcloud.`;
const pageDescription = post.description
  ? (post.description.length > 160 ? post.description.substring(0, 157).trimEnd() + '…' : post.description)
  : (baseDesc.length > 160 ? baseDesc.substring(0, 157).trimEnd() + '…' : baseDesc);

// Build structured track data for enhanced MusicRecording schema
const structuredTracks = post.tracklist?.map((track, index) => {
  const trackLabel = trackLabels.get(track);
  const parts = track.split(' - ');
  const artist = parts[0]?.replace(/,$/, '') || '';
  const title = parts.slice(1).join(' - ').replace(/,$/, '') || track;
  return {
    position: index + 1,
    artist,
    title,
    label: trackLabel ? { name: trackLabel.name, url: trackLabel.url } : null
  };
}) || [];

const breadcrumbSegments = [
  { label: "Home", href: "/" },
  { label: "DJ Hulk", href: "/djhulk-electronic-music/" },
  { label: "Weekly DJ Mixes", href: "/dj/mixes-weekly" },
  { label: curDisplayLabel.label }
];

// Build JSON-LD using schema builders
const blogPostingSchema = buildBlogPostingSchema(post);
const audioObjectSchema = buildAudioObjectSchema(post, structuredTracks);
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbSegments);
const labelEntitiesSchema = buildLabelEntities(structuredTracks);
const tracklistItemListSchema = buildTracklistItemList(post, structuredTracks);

// Keywords for SEO
const keywords = [
  'DJ Mix', 'House', 'Tech House', 'Deep House', 'Electronic Music',
  'Tracklist', 'Mixcloud', 'DJ Hulk', 'Stuttgart',
  ...(post.tags || []),
  ...(post.useCases || []),
  ...topLabelNames,
].join(', ');

// Custom OG image path
const customOgImage = `/og/mix-${post.slug}.jpg`;

const jsonLd = [
  getDjPersonSchema(),
  blogPostingSchema,
  audioObjectSchema,
  breadcrumbSchema,
  labelEntitiesSchema,
  tracklistItemListSchema,
].filter(Boolean);

---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={customOgImage}
  ogTitle={enhancedTitle}
  ogType="music.playlist"
  ogImageWidth={1200}
  ogImageHeight={630}
  twitterPlayerUrl={post.src}
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Navbar currentPage="/dj/mixes/" />

  <Breadcrumb segments={breadcrumbSegments} />

  <section class="pt-8 pb-16 hero-gradient">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="sr-only">Mix Details and Tracklist</h2>
      <MixDetail post={post} isLatest={isLatest} />

      {/* Navigation between mixes */}
      <div class="max-w-4xl mx-auto mt-12">
        <div class="flex flex-wrap justify-between gap-4">
{nextPost ? (
  <a href={`/dj/mixes/${nextPost.slug}`} class="flex items-center gap-3 px-5 py-3 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors group">
    <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    <div class="text-left">
      <span class="text-xs text-[var(--color-text-muted)] block">Previous</span>
      <span class="font-medium text-[var(--color-text)]">{getMixDisplay(nextPost.key, nextPost.title).label}</span>
    </div>
  </a>
) : <div></div>}

{prevPost ? (
  <a href={`/dj/mixes/${prevPost.slug}`} class="flex items-center gap-3 px-5 py-3 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors group">
    <div class="text-right">
      <span class="text-xs text-[var(--color-text-muted)] block">Next</span>
      <span class="font-medium text-[var(--color-text)]">{getMixDisplay(prevPost.key, prevPost.title).label}</span>
    </div>
    <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
) : <div></div>}
        </div>
      </div>

      {/* Back to overview */}
      <div class="flex flex-wrap justify-center gap-4 mt-10">
         <a href="/dj/mixes-weekly" class="btn-secondary">
          ← Back to Weekly DJ Mixes
        </a>
        <a href="/dj/mixes-blog-archive" class="btn-secondary">
          View Archive
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>