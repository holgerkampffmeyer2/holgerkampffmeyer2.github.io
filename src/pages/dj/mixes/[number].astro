---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import MixDetail from "../../../components/dj/MixDetail.astro";
import { getDjPersonSchema } from "../../../utils/dj-schema.js";
import type { BlogPostData } from "../../../types/blog";
import { loadBlogPosts } from "../../../utils/blog-data";
import labelsData from "../../../data/labels.json";
import { buildTrackLabels } from "../../../utils/track-labels.js";
import {
  buildStructuredTracks,
  countTopLabels,
  getCandidates,
  type TrackLabelResolver,
} from "../../../utils/mix-track-data.js";
import { brandedOgImagePath } from "../../../utils/og-image.js";
import {
  buildMixTitle,
  buildMixDescription,
  buildMixIntro,
  buildMixBreadcrumbLabel,
  buildRelatedMixes,
  type MixCandidate,
  type MixLabelInfo,
} from "../../../utils/mix-seo.js";
import {
  buildBlogPostingSchema,
  buildAudioObjectSchema,
  buildBreadcrumbSchema,
  buildLabelEntities,
  buildTracklistItemList,
} from "../../../utils/schema-builders.js";
import { isIndexableLabel } from "../../../utils/label-indexability.mjs";

export async function getStaticPaths() {
  const allPosts = await loadBlogPosts();
  const postsWithTracklists = allPosts.filter((post: BlogPostData) => post.hasTracklist);

   return postsWithTracklists.map((post: BlogPostData, index: number) => {
      const currentIndex = index;
      const prevPost = currentIndex < postsWithTracklists.length - 1 ? postsWithTracklists[currentIndex + 1] : null;
      const nextPost = currentIndex > 0 ? postsWithTracklists[currentIndex - 1] : null;
      const isLatest = index === 0;

      return {
         params: { number: post.slug },
        props: { post, prevPost, nextPost, isLatest }
      };
    });
}

interface Props {
  post: BlogPostData;
  prevPost: BlogPostData | null;
  nextPost: BlogPostData | null;
  isLatest: boolean;
}

const { post, prevPost, nextPost, isLatest } = Astro.props;

// Build track labels for this mix
const trackLabels = buildTrackLabels(labelsData) as TrackLabelResolver;

const topLabels: MixLabelInfo[] = countTopLabels(post.tracklist || [], trackLabels, 5);

const topLabelNames = topLabels.map(l => l.name);

// Build enhanced title with top labels
const enhancedTitle = buildMixTitle(post, topLabels);
const pageTitle = enhancedTitle;

const pageDescription = buildMixDescription(post, topLabels);
const introSentences = buildMixIntro(post, topLabels);

const allMixPosts = (await loadBlogPosts()).filter((entry: BlogPostData) => entry.hasTracklist);
const candidates: MixCandidate[] = getCandidates(allMixPosts, trackLabels);
const relatedMixes = buildRelatedMixes(post, candidates, 3);

// Build structured track data for enhanced MusicRecording schema
const structuredTracks = buildStructuredTracks(post.tracklist || [], trackLabels);

const breadcrumbSegments = [
  { label: "Home", href: "/" },
  { label: "DJ Hulk", href: "/djhulk-electronic-music/" },
  { label: "Weekly DJ Mixes", href: "/dj/mixes-weekly" },
  { label: buildMixBreadcrumbLabel(post) }
];

// Build JSON-LD using schema builders
const blogPostingSchema = buildBlogPostingSchema(post, { description: pageDescription });
const audioObjectSchema = buildAudioObjectSchema(post, structuredTracks, { isLabelIndexable: isIndexableLabel });
const breadcrumbSchema = buildBreadcrumbSchema(breadcrumbSegments);
const labelEntitiesSchema = buildLabelEntities(structuredTracks, { isLabelIndexable: isIndexableLabel });
const tracklistItemListSchema = buildTracklistItemList(post, structuredTracks, { isLabelIndexable: isIndexableLabel });

// Keywords for SEO
const keywords = [
  'DJ Mix', 'House', 'Tech House', 'Deep House', 'Electronic Music',
  'Tracklist', 'Mixcloud', 'DJ Hulk', 'Stuttgart',
  ...(post.tags || []),
  ...(post.useCases || []),
  ...topLabelNames,
].join(', ');

// Custom OG image path
const customOgImage = brandedOgImagePath(post.slug);

const jsonLd = [
  getDjPersonSchema(),
  blogPostingSchema,
  audioObjectSchema,
  breadcrumbSchema,
  labelEntitiesSchema,
  tracklistItemListSchema,
].filter(Boolean);

---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={customOgImage}
  ogTitle={enhancedTitle}
  ogType="music.playlist"
  ogImageWidth={1200}
  ogImageHeight={630}
  twitterPlayerUrl={post.src}
  jsonLd={jsonLd}
  keywords={keywords}
>
  <Navbar currentPage="/dj/mixes/" />

  <Breadcrumb segments={breadcrumbSegments} />

  <section class="pt-8 pb-16 hero-gradient" aria-labelledby="mix-detail-heading">
    <div class="max-w-6xl mx-auto px-4">
      <h1 id="mix-detail-heading" class="sr-only">{post.title}</h1>
      <MixDetail post={post} isLatest={isLatest} introSentences={introSentences} relatedMixes={relatedMixes} topLabels={topLabels} />

      {/* Navigation between mixes */}
      <div class="max-w-4xl mx-auto mt-12">
        <div class="flex flex-wrap justify-between gap-4">
{nextPost ? (
  <a href={`/dj/mixes/${nextPost.slug}`} class="flex items-center gap-3 px-5 py-3 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors group">
    <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    <div class="text-left">
      <span class="text-xs text-[var(--color-text-muted)] block">Previous</span>
      <span class="font-medium text-[var(--color-text)]">{buildMixBreadcrumbLabel(nextPost)}</span>
    </div>
  </a>
) : <div></div>}

{prevPost ? (
  <a href={`/dj/mixes/${prevPost.slug}`} class="flex items-center gap-3 px-5 py-3 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors group">
    <div class="text-right">
      <span class="text-xs text-[var(--color-text-muted)] block">Next</span>
      <span class="font-medium text-[var(--color-text)]">{buildMixBreadcrumbLabel(prevPost)}</span>
    </div>
    <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </a>
) : <div></div>}
        </div>
      </div>

      {/* Back to overview */}
      <div class="flex flex-wrap justify-center gap-4 mt-10">
         <a href="/dj/mixes-weekly" class="btn-secondary">
          ← Back to Weekly DJ Mixes
        </a>
        <a href="/dj/mixes-blog-archive" class="btn-secondary">
          View Archive
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>