---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import heroImg from '../assets/img/header-work.jpg';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import openSourceProjects from '../data/open-source-projects.json';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Holger Kampffmeyer",
  "url": "https://holger-kampffmeyer.de/work/",
  "jobTitle": "Director DevOps - AI Agentic Development, Platform Engineering, Cloud Native",
  "worksFor": {
    "@type": "Organization",
    "name": "Vector",
    "url": "https://www.vector.com"
  },
  "sameAs": [
    "https://www.xing.com/profile/Holger_Kampffmeyer",
    "https://www.linkedin.com/in/holger-kampffmeyer-390b6789/"
  ],
  "knowsAbout": [
    "DevOps",
    "Project Management",
    "AI and Agentic Software Development",
    "Software Architecture",
    "Agile",
    "Scrum",
    "Kanban",
    "Cloud",
    "Docker",
    "Kubernetes",
    "Continuous Integration",
    "Continuous Delivery"
  ]
};
---

<Layout 
   title="Holger Kampffmeyer - Director DevOps, AI & Platform Engineering"
   description="Holger Kampffmeyer - Director DevOps bei Vector. Expertise in AI Agentic Development, Platform Engineering, Cloud Native Architecture, and DevOps leadership."
   image="/img/header-work.webp"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://holger-kampffmeyer.de/"},
        {"@type": "ListItem", "position": 2, "name": "Work", "item": "https://holger-kampffmeyer.de/work/"}
      ]
    },
    personSchema
  ]}
>
  <Navbar currentPage="/work/" />

  <Hero 
    image={heroImg}
    variant="secondary"
  >
    <div class="max-w-3xl pt-32 text-center">
      <h1 class="font-play text-5xl md:text-7xl lg:text-8xl font-bold mb-6 gradient-text animate-fadeInUp stagger-2">Work / Research</h1>
      <p class="text-[var(--color-text-muted)] text-xl md:text-2xl mb-8 max-w-2xl animate-fadeInUp stagger-3">Director DevOps · AI Agentic Development · Platform Engineering</p>
    </div>
  </Hero>

  <!-- Open Source Section - Moved to top -->
  <section id="opensource" class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Open Source</span>
        <h2 class="font-play text-4xl font-bold mt-4">AI Agent Projects</h2>
      </div>
      
      <div class="max-w-4xl mx-auto">
        {openSourceProjects.projects.map((project, index) => {
          const isInitiallyOpen = index === 0;
          const detailsId = `project-details-${index}`;

          return (
            <div
              class={`project-card bg-[var(--color-surface)] rounded-xl p-6 animate-on-scroll hover:border-[var(--color-secondary)] border border-transparent transition-all ${index > 0 ? 'mt-6' : ''}`}
              data-project-card
              data-expanded={isInitiallyOpen ? 'true' : 'false'}
            >
              <div
                class="project-toggle w-full flex items-start gap-4 text-left cursor-pointer"
                data-project-toggle
                data-project={project.name}
              >
                <div class="w-20 h-20 bg-[var(--color-bg)] rounded-lg flex items-center justify-center shrink-0">
                  <img src={project.image} alt={project.imageAlt} width="80" height="80" loading="lazy" decoding="async" class="w-20 h-20 rounded-lg object-cover">
                </div>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <a href={project.url} target="_blank" rel="noopener noreferrer nofollow" class="font-bold text-lg hover:text-[var(--color-secondary)] transition-colors">
                      {project.name}
                    </a>
                    <button
                      type="button"
                      data-project-toggle-button
                      class="project-toggle-button shrink-0 rounded-full p-1 hover:bg-[var(--color-bg)] focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-secondary)]"
                      aria-expanded={isInitiallyOpen ? 'true' : 'false'}
                      aria-controls={detailsId}
                      aria-label={`${project.name} Details ${isInitiallyOpen ? 'ausblenden' : 'einblenden'}`}
                    >
                      <Icon name="chevron-down" class="toggle-icon w-5 h-5 text-[var(--color-secondary)] transition-transform" />
                    </button>
                  </div>
                  <p class="text-[var(--color-text-muted)] text-sm mt-2">
                    {project.description}
                  </p>
                  <a href={project.url} target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-2 text-[var(--color-secondary)] text-sm mt-3 hover:underline">
                    <Icon name="github" class="w-4 h-4" />
                    View on GitHub
                  </a>
                </div>
              </div>
              <div class="project-details" id={detailsId} data-project-details aria-hidden={isInitiallyOpen ? 'false' : 'true'}>
                <div class="project-details-clip">
                  <div class="mt-4 pl-24">
                    <h3 class="font-bold text-sm text-[var(--color-secondary)] uppercase tracking-wider mb-3">Features</h3>
                    <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                      {project.features.map((feature) => (
                        <li class="flex items-center gap-2 text-[var(--color-text-muted)] text-sm">
                          <span class="w-1.5 h-1.5 bg-[var(--color-secondary)] rounded-full shrink-0"></span>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Expertise</span>
        <h2 class="font-play text-4xl font-bold mt-4">Technical Skills</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <h3 class="font-bold text-xl mb-4 text-[var(--color-secondary)]">AI Agentic Development</h3>
          <ul class="space-y-2 text-[var(--color-text-muted)]">
            <li>• Claude Code & OpenCode</li>
            <li>• GitHub Copilot & Cursor</li>
            <li>• Multi-Agent Systems</li>
            <li>• Autonomous Workflow Automation</li>
            <li>• AI-powered DevOps</li>
          </ul>
        </div>
        
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <h3 class="font-bold text-xl mb-4 text-[var(--color-secondary)]">Platform Engineering</h3>
          <ul class="space-y-2 text-[var(--color-text-muted)]">
            <li>• Kubernetes & Docker</li>
            <li>• GitOps (Github Actions, Flux)</li>
            <li>• Terraform & Ansible</li>
            <li>• AWS, Azure, on Prem</li>
            <li>• Self-service Infrastructure</li>
          </ul>
        </div>
        
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <h3 class="font-bold text-xl mb-4 text-[var(--color-secondary)]">Leadership & Delivery</h3>
          <ul class="space-y-2 text-[var(--color-text-muted)]">
            <li>• Team Leadership</li>
            <li>• Scrum & Kanban</li>
            <li>• CI/CD Pipeline Architecture</li>
            <li>• DevOps & Developer Experience</li>
            <li>• Enterprise Delivery</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Work Section -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl mx-auto">
        <div class="bg-[var(--color-surface)] rounded-xl p-8 animate-on-scroll">
          <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Current Role</span>
          <h2 class="font-play text-3xl font-bold mt-4 mb-6">Director DevOps at Vector</h2>
          
          <div class="space-y-4 text-[var(--color-text-muted)]">
            <p>
              I work as Director DevOps for <a href="http://www.vector.com" target="_blank" rel="noopener noreferrer nofollow" class="text-[var(--color-secondary)] hover:underline">Vector</a>, a leading software company with 4000+ employees building tools for the automotive and embedded software industry.
            </p>
            
            <p>My current focus areas:</p>
            <ul class="list-disc list-inside space-y-2 ml-4">
              <li>AI Agentic Software Development & Automation</li>
              <li>Platform Engineering & Developer Experience</li>
              <li>Building autonomous DevOps workflows with AI agents</li>
              <li>Leading high-performance DevOps teams</li>
              <li>Cloud-native architecture & GitOps</li>
            </ul>
            
            <p class="mt-4">
               Connect with me on <a href="https://www.xing.com/profile/Holger_Kampffmeyer" target="_blank" rel="noopener noreferrer nofollow" class="text-[var(--color-secondary)] hover:underline">Xing</a> or <a href="https://www.linkedin.com/in/holger-kampffmeyer-390b6789/" target="_blank" rel="noopener noreferrer nofollow" class="text-[var(--color-secondary)] hover:underline">LinkedIn</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Publications Section -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Publications</span>
        <h2 class="font-play text-4xl font-bold mt-4">Research Papers</h2>
      </div>
      
      <div class="space-y-6 max-w-4xl mx-auto">
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <a href="/files/models07_dpio.pdf" target="_blank" class="font-bold text-lg hover:text-[var(--color-secondary)] transition-colors">
            Finding the Pattern You Need: The Design Pattern Intent Ontology
          </a>
          <p class="text-[var(--color-text-muted)] text-sm mt-2">University Research Paper</p>
        </div>
        
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <a href="/files/dasson07.pdf" target="_blank" class="font-bold text-lg hover:text-[var(--color-secondary)] transition-colors">
            EPITELLA: Improving the Gnutella Search Algorithm through Epidemic Spreading Models for Complex Networks
          </a>
          <p class="text-[var(--color-text-muted)] text-sm mt-2">University Research Paper</p>
        </div>
        
        <div class="bg-[var(--color-bg)] rounded-xl p-6 animate-on-scroll">
          <a href="/files/hkampffm_P2PGnutImprovingReport.pdf.pdf" target="_blank" class="font-bold text-lg hover:text-[var(--color-secondary)] transition-colors">
            Improving Gnutella Search Algorithms through Epidemic Dissemination
          </a>
          <p class="text-[var(--color-text-muted)] text-sm mt-2">University Research Paper</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social Links Section -->
  <section class="section-padding bg-[var(--color-bg)]">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-[var(--color-secondary)] text-lg tracking-widest uppercase">Connect</span>
      <h2 class="font-play text-4xl font-bold mt-4 mb-8">Let's Connect</h2>
      
      <div class="flex justify-center gap-6">
        <a
          href="https://www.linkedin.com/in/holger-kampffmeyer-390b6789/"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex items-center gap-3 bg-[var(--color-surface)] px-6 py-4 rounded-xl hover:bg-[var(--color-primary)]/20 transition-all duration-300 group"
        >
          <Icon name="linkedin" class="w-8 h-8" />
          <span class="font-bold group-hover:text-[var(--color-secondary)] transition-colors">LinkedIn</span>
        </a>
        <a
          href="https://www.xing.com/profile/Holger_Kampffmeyer"
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex items-center gap-3 bg-[var(--color-surface)] px-6 py-4 rounded-xl hover:bg-[var(--color-primary)]/20 transition-all duration-300 group"
        >
          <Icon name="xing" class="w-8 h-8" />
          <span class="font-bold group-hover:text-[var(--color-secondary)] transition-colors">XING</span>
        </a>
      </div>
    </div>
  </section>

  <style>
    .project-card[data-expanded='true'] {
      border-color: var(--color-secondary);
      box-shadow: 0 16px 36px rgb(0 0 0 / 0.22);
    }

    .project-toggle-button {
      transition: background-color 0.3s ease;
    }

    .toggle-icon {
      transition: transform 0.35s ease;
    }

    .project-card[data-expanded='true'] .toggle-icon {
      transform: rotate(180deg);
    }

    .project-details {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition: grid-template-rows 0.35s ease, opacity 0.25s ease;
    }

    .project-card[data-expanded='true'] .project-details {
      grid-template-rows: 1fr;
      opacity: 1;
    }

    .project-details-clip {
      min-height: 0;
      overflow: hidden;
      transform: translateY(-6px);
      transition: transform 0.35s ease;
    }

    .project-card[data-expanded='true'] .project-details-clip {
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .project-details,
      .project-details-clip,
      .toggle-icon {
        transition: none;
      }
    }
  </style>

  <script>
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

    function setExpanded(card: HTMLElement, expanded: boolean) {
      card.setAttribute('data-expanded', String(expanded));

      const toggle = card.querySelector('[data-project-toggle-button]');
      const details = card.querySelector('[data-project-details]');
      const name = card.querySelector('[data-project-toggle]')?.getAttribute('data-project') ?? '';

      toggle?.setAttribute('aria-expanded', String(expanded));
      toggle?.setAttribute('aria-label', `${name} Details ${expanded ? 'ausblenden' : 'einblenden'}`);
      details?.setAttribute('aria-hidden', String(!expanded));
    }

    cards.forEach((card) => {
      const header = card.querySelector('[data-project-toggle]');
      const button = card.querySelector('[data-project-toggle-button]');
      const toggleCard = () => setExpanded(card, card.getAttribute('data-expanded') !== 'true');

      header?.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) return;
        toggleCard();
      });

      button?.addEventListener('click', (event) => {
        event.stopPropagation();
        toggleCard();
      });
    });

    let focusedCard = cards[0] ?? null;
    let scrollScheduled = false;

    function applyFocus(card: HTMLElement) {
      focusedCard = card;
      cards.forEach((item) => {
        const shouldBeOpen = item === card;
        if (item.getAttribute('data-expanded') !== String(shouldBeOpen)) {
          setExpanded(item, shouldBeOpen);
        }
      });
    }

    function updateFocus() {
      scrollScheduled = false;
      if (!cards.length) return;

      const focusLine = window.innerHeight * 0.42;
      const candidates = cards.flatMap((card) => {
        const header = card.querySelector('[data-project-toggle]');
        if (!header) return [];

        const rect = header.getBoundingClientRect();
        return [{
          card,
          top: rect.top,
          bottom: rect.bottom,
          distance: Math.abs(rect.top + rect.height / 2 - focusLine),
        }];
      });

      if (!candidates.length) return;

      const containing = candidates.find(({ top, bottom }) => top <= focusLine && bottom >= focusLine);
      const nearest = candidates.reduce((closest, candidate) => (
        candidate.distance < closest.distance ? candidate : closest
      ));

      if (!containing && focusedCard) {
        const current = candidates.find(({ card }) => card === focusedCard);
        if (current && current.distance < nearest.distance + 32) return;
      }

      applyFocus((containing ?? nearest).card);
    }

    function scheduleFocusUpdate() {
      if (scrollScheduled) return;
      scrollScheduled = true;
      window.requestAnimationFrame(updateFocus);
    }

    window.addEventListener('scroll', scheduleFocusUpdate, { passive: true });
    window.addEventListener('resize', scheduleFocusUpdate, { passive: true });

    if (focusedCard) applyFocus(focusedCard);
  </script>

  <Footer />
</Layout>