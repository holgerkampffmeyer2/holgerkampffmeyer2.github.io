---
interface Props {
  images: { src: string; alt: string }[];
  initialIndex?: number;
}

const { images, initialIndex = 0 } = Astro.props;
---

<dialog
  id="lightbox"
  class="lightbox fixed inset-0 z-[100] hidden"
  data-images={JSON.stringify(images)}
  data-initial-index={initialIndex}
>
  <div class="lightbox-backdrop absolute inset-0 bg-black/95 backdrop-blur-sm" aria-hidden="true"></div>

  <button
    class="lightbox-close fixed top-6 right-6 z-10 p-2 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm"
    aria-label="Lightbox schließen"
    data-lightbox-close
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button
    class="lightbox-nav lightbox-prev fixed left-6 top-1/2 -translate-y-1/2 z-10 p-3 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm hidden sm:flex"
    aria-label="Vorheriges Bild"
    data-lightbox-prev
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    class="lightbox-nav lightbox-next fixed right-6 top-1/2 -translate-y-1/2 z-10 p-3 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm hidden sm:flex"
    aria-label="Nächstes Bild"
    data-lightbox-next
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="lightbox-content absolute inset-0 flex items-center justify-center p-4">
    <figure class="max-w-full max-h-full">
      <img
        id="lightbox-img"
        src={images[initialIndex]?.src}
        alt={images[initialIndex]?.alt ?? ''}
        class="max-w-full max-h-[90vh] object-contain"
      />
      <figcaption id="lightbox-caption" class="sr-only"></figcaption>
    </figure>
  </div>

  <div class="lightbox-counter fixed bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-sm font-mono hidden sm:block" aria-live="polite">
    <span id="lightbox-current">1</span> / <span id="lightbox-total">{images.length}</span>
  </div>

  <div class="lightbox-thumbs fixed bottom-6 left-1/2 -translate-x-1/2 flex gap-2 p-2 max-w-[90vw] overflow-x-auto hidden lg:flex" role="tablist" aria-label="Miniaturansichten">
    {images.map((img, i) => (
      <button
        class="lightbox-thumb flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all duration-200 {i === initialIndex ? 'border-[var(--color-secondary)] scale-110' : 'border-transparent opacity-60 hover:opacity-100'}"
        role="tab"
        aria-selected={i === initialIndex}
        aria-label={`Zu Bild ${i + 1}`}
        data-lightbox-thumb={i}
      >
        <img src={img.src} alt="" class="w-full h-full object-cover" loading="lazy" />
      </button>
    ))}
  </div>
</dialog>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dialog) return;

    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const caption = document.getElementById('lightbox-caption');
    const currentEl = document.getElementById('lightbox-current');
    const thumbs = dialog.querySelectorAll<HTMLButtonElement>('[data-lightbox-thumb]');
    const images: { src: string; alt: string }[] = JSON.parse(dialog.dataset.images || '[]');

    let index = parseInt(dialog.dataset.initialIndex || '0', 10);
    let isOpen = false;
    const preloadCache = new Set<number>();

    const updateImage = () => {
      const image = images[index];
      if (!image) return;
      img.src = image.src;
      img.alt = image.alt;
      if (caption) caption.textContent = image.alt;
      if (currentEl) currentEl.textContent = String(index + 1);
    };

    const updateThumbs = () => {
      thumbs.forEach((thumb, i) => {
        const active = i === index;
        thumb.classList.toggle('border-[var(--color-secondary)]', active);
        thumb.classList.toggle('scale-110', active);
        thumb.classList.toggle('border-transparent', !active);
        thumb.classList.toggle('opacity-60', !active);
        thumb.setAttribute('aria-selected', String(active));
      });
      thumbs[index]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
    };

    const preloadAdjacent = () => {
      if (images.length < 2) return;
      const prevIdx = (index - 1 + images.length) % images.length;
      const nextIdx = (index + 1) % images.length;
      [prevIdx, nextIdx].forEach((idx) => {
        if (preloadCache.has(idx)) return;
        const link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.href = images[idx].src;
        document.head.appendChild(link);
        preloadCache.add(idx);
      });
    };

    const open = (startIndex: number) => {
      index = startIndex;
      updateImage();
      updateThumbs();
      preloadAdjacent();
      dialog.showModal();
      isOpen = true;
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      dialog.close();
      isOpen = false;
      document.body.style.overflow = '';
    };

    const prev = () => {
      index = (index - 1 + images.length) % images.length;
      updateImage();
      updateThumbs();
      preloadAdjacent();
    };

    const next = () => {
      index = (index + 1) % images.length;
      updateImage();
      updateThumbs();
      preloadAdjacent();
    };

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', prev);
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', next);
    dialog.querySelector('.lightbox-backdrop')?.addEventListener('click', close);

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        index = parseInt(thumb.dataset.lightboxThumb || '0', 10);
        updateImage();
        updateThumbs();
        preloadAdjacent();
      });
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-gallery-index]');
      if (!trigger) return;
      const startIndex = parseInt(trigger.dataset.galleryIndex || '0', 10);
      if (Number.isNaN(startIndex)) return;
      open(startIndex);
    });
  });
</script>

<style>
  .lightbox[open] {
    display: block;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    animation: fadeIn 0.2s ease-out;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox-content figure {
    animation: zoomIn 0.2s ease-out;
  }

  @keyframes zoomIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .lightbox-thumb {
    border-radius: 8px;
  }

  .lightbox-thumb img {
    transition: transform 0.2s ease;
  }

  .lightbox-thumb:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      padding: 2rem 1rem;
    }
    .lightbox-prev { left: 0; }
    .lightbox-next { right: 0; }
  }
</style>
