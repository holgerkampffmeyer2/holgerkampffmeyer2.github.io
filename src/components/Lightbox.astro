---
interface Props {
  images: { src: string; alt: string }[];
  initialIndex?: number;
}

const { images, initialIndex = 0 } = Astro.props;
---

<dialog id="lightbox" class="lightbox fixed inset-0 z-[100] hidden">
  <div class="lightbox-backdrop absolute inset-0 bg-black/95 backdrop-blur-sm" aria-hidden="true"></div>
  
  <button 
    class="lightbox-close fixed top-6 right-6 z-10 p-2 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm"
    aria-label="Lightbox schließen"
    data-lightbox-close
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <button 
    class="lightbox-nav lightbox-prev fixed left-6 top-1/2 -translate-y-1/2 z-10 p-3 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm hidden sm:flex"
    aria-label="Vorheriges Bild"
    data-lightbox-prev
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button 
    class="lightbox-nav lightbox-next fixed right-6 top-1/2 -translate-y-1/2 z-10 p-3 text-white/80 hover:text-white transition-colors rounded-full bg-white/10 backdrop-blur-sm hidden sm:flex"
    aria-label="Nächstes Bild"
    data-lightbox-next
  >
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="lightbox-content absolute inset-0 flex items-center justify-center p-4">
    <figure class="max-w-full max-h-full">
      <img 
        id="lightbox-img" 
        src={images[initialIndex].src} 
        alt={images[initialIndex].alt}
        class="max-w-full max-h-[90vh] object-contain"
      />
      <figcaption id="lightbox-caption" class="sr-only"></figcaption>
    </figure>
  </div>

  <div class="lightbox-counter fixed bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-sm font-mono hidden sm:block" aria-live="polite">
    <span id="lightbox-current">1</span> / <span id="lightbox-total">{images.length}</span>
  </div>

  <div class="lightbox-thumbs fixed bottom-6 left-1/2 -translate-x-1/2 flex gap-2 p-2 max-w-[90vw] overflow-x-auto hidden lg:flex" role="tablist" aria-label="Miniaturansichten">
    {images.map((img, i) => (
      <button
        class="lightbox-thumb flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 transition-all duration-200 {i === initialIndex ? 'border-[var(--color-secondary)] scale-110' : 'border-transparent opacity-60 hover:opacity-100'}"
        role="tab"
        aria-selected={i === initialIndex}
        aria-label={`Zu Bild ${i + 1}`}
        data-lightbox-thumb={i}
      >
        <img src={img.src} alt="" class="w-full h-full object-cover" loading="lazy" />
      </button>
    ))}
  </div>
</dialog>

<script>
  class Lightbox {
    constructor() {
      this.dialog = document.getElementById('lightbox');
      this.img = document.getElementById('lightbox-img');
      this.caption = document.getElementById('lightbox-caption');
      this.currentEl = document.getElementById('lightbox-current');
      this.thumbs = this.dialog.querySelectorAll('[data-lightbox-thumb]');
      this.images = {images};
      this.index = {initialIndex};
      this.isOpen = false;
      this.preloadCache = new Map();
      
      this.bindEvents();
      this.preloadAdjacent();
    }

    bindEvents() {
      this.dialog.querySelector('[data-lightbox-close]').addEventListener('click', () => this.close());
      this.dialog.querySelector('[data-lightbox-prev]').addEventListener('click', () => this.prev());
      this.dialog.querySelector('[data-lightbox-next]').addEventListener('click', () => this.next());
      this.dialog.querySelector('.lightbox-backdrop').addEventListener('click', () => this.close());
      
      this.thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => this.goTo(parseInt(thumb.dataset.lightboxThumb!)));
      });

      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;
        if (e.key === 'Escape') this.close();
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });

      this.dialog.addEventListener('click', (e) => {
        if (e.target === this.dialog) this.close();
      });
    }

    open(index = this.index) {
      this.index = index;
      this.updateImage();
      this.dialog.showModal();
      this.isOpen = true;
      document.body.style.overflow = 'hidden';
      this.updateThumbs();
      this.preloadAdjacent();
    }

    close() {
      this.dialog.close();
      this.isOpen = false;
      document.body.style.overflow = '';
    }

    prev() {
      this.index = (this.index - 1 + this.images.length) % this.images.length;
      this.updateImage();
      this.updateThumbs();
      this.preloadAdjacent();
    }

    next() {
      this.index = (this.index + 1) % this.images.length;
      this.updateImage();
      this.updateThumbs();
      this.preloadAdjacent();
    }

    goTo(index) {
      this.index = index;
      this.updateImage();
      this.updateThumbs();
      this.preloadAdjacent();
    }

    updateImage() {
      const img = this.images[this.index];
      this.img.src = img.src;
      this.img.alt = img.alt;
      this.caption.textContent = img.alt;
      this.currentEl.textContent = this.index + 1;
    }

    updateThumbs() {
      this.thumbs.forEach((thumb, i) => {
        const active = i === this.index;
        thumb.classList.toggle('border-[var(--color-secondary)]', active);
        thumb.classList.toggle('scale-110', active);
        thumb.classList.toggle('border-transparent', !active);
        thumb.classList.toggle('opacity-60', !active);
        thumb.setAttribute('aria-selected', active.toString());
      });
      
      const activeThumb = this.thumbs[this.index];
      if (activeThumb) {
        activeThumb.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }
    }

    preloadAdjacent() {
      const prevIdx = (this.index - 1 + this.images.length) % this.images.length;
      const nextIdx = (this.index + 1) % this.images.length;
      [prevIdx, nextIdx].forEach(idx => {
        if (!this.preloadCache.has(idx)) {
          const link = document.createElement('link');
          link.rel = 'preload';
          link.as = 'image';
          link.href = this.images[idx].src;
          document.head.appendChild(link);
          this.preloadCache.set(idx, true);
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const instance = new Lightbox();
    document.getElementById('lightbox').__lightbox = instance;
  });
</script>

<style>
  .lightbox[open] {
    display: block;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .lightbox-content figure {
    animation: zoomIn 0.2s ease-out;
  }

  @keyframes zoomIn {
    from { 
      opacity: 0;
      transform: scale(0.95);
    }
    to { 
      opacity: 1;
      transform: scale(1);
    }
  }

  .lightbox-thumb {
    border-radius: 8px;
  }

  .lightbox-thumb img {
    transition: transform 0.2s ease;
  }

  .lightbox-thumb:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .lightbox-nav {
      padding: 2rem 1rem;
    }
    .lightbox-prev { left: 0; }
    .lightbox-next { right: 0; }
  }
</style>