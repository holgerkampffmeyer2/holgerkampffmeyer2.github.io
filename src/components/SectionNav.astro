---
interface SectionLink {
  id: string;
  label: string;
}

interface Props {
  sections: SectionLink[];
  class?: string;
}

const { sections, class: className = '' } = Astro.props;
---

<div class={`sticky top-20 z-40 bg-[var(--color-bg)]/90 backdrop-blur-md border-b border-[var(--color-border)] ${className}`} data-section-nav>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex gap-4 sm:gap-8 overflow-x-auto scrollbar-hide py-2.5" aria-label="Section navigation">
    {sections.map(s => (
      <a href={`#${s.id}`} class="nav-link text-xs sm:text-sm whitespace-nowrap" data-section-link={s.id}>
        {s.label}
      </a>
    ))}
  </nav>
</div>

<script>
  (function () {
    var links = document.querySelectorAll("[data-section-link]");
    var sections: HTMLElement[] = Array.from(document.querySelectorAll("section[id]"));
    if (!links.length || !sections.length) return;

    function updateActive(id: string) {
      links.forEach(function (link) {
        link.classList.toggle("active", link.getAttribute("data-section-link") === id);
      });
    }

    // Primary: IntersectionObserver with generous rootMargin
    var observer = new IntersectionObserver(
      function (entries) {
        var visible: { id: string; ratio: number }[] = [];
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            visible.push({ id: entry.target.id, ratio: entry.intersectionRatio });
          }
        });
        if (visible.length === 0) return;
        visible.sort(function (a, b) { return b.ratio - a.ratio; });
        updateActive(visible[0].id);
      },
      { threshold: [0, 0.1, 0.25, 0.5, 0.75, 1], rootMargin: "-80px 0px -50% 0px" }
    );

    sections.forEach(function (section) {
      observer.observe(section);
    });

    // Re-observe sections when their size changes (e.g., lazy images load)
    var resizeObserver = new ResizeObserver(function (entries) {
      entries.forEach(function (entry) {
        observer.unobserve(entry.target);
        observer.observe(entry.target);
      });
    });
    sections.forEach(function (section) {
      resizeObserver.observe(section);
    });

    // Fallback: scroll-based detection using getBoundingClientRect
    // Handles edge cases where IntersectionObserver misses dynamic content
    var scrollTimeout: number;
    function checkScrollPosition() {
      var bestSection: HTMLElement | null = null;
      var bestScore = -1;
      var navHeight = 80; // sticky nav offset

      for (var i = 0; i < sections.length; i++) {
        var section = sections[i];
        var rect = section.getBoundingClientRect();
        var sectionTop = rect.top;
        var sectionBottom = rect.bottom;
        var viewportHeight = window.innerHeight;

        // Section is visible if it overlaps with the "active zone" (below nav, above 50% of viewport)
        var activeZoneTop = navHeight;
        var activeZoneBottom = viewportHeight * 0.5;

        // Calculate overlap with active zone
        var overlapTop = Math.max(sectionTop, activeZoneTop);
        var overlapBottom = Math.min(sectionBottom, activeZoneBottom);
        var overlap = Math.max(0, overlapBottom - overlapTop);

        if (overlap > bestScore) {
          bestScore = overlap;
          bestSection = section;
        }
      }

      if (bestSection) {
        updateActive(bestSection.id);
      }
    }

    window.addEventListener("scroll", function () {
      clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(checkScrollPosition, 50);
    }, { passive: true });

    // Initial check
    checkScrollPosition();

    links.forEach(function (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        var id = link.getAttribute("data-section-link");
        if (!id) return;
        var target = document.getElementById(id);
        if (target) {
          var top = target.getBoundingClientRect().top + window.scrollY - 90;
          window.scrollTo({ top: top, behavior: "smooth" });
        }
      });
    });
  })();
</script>
