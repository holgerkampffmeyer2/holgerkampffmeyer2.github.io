---
import Icon from '../Icon.astro';
import PressPhotoGrid from '../PressPhotoGrid.astro';
import ShareButtons from '../ShareButtons.astro';
import SocialStats from '../SocialStats.astro';
import { bookingContent, bookingMailto, type BookingLocale } from '../../data/booking';
import { getFaqsForPage } from '../../data/faqs';

interface Props {
  lang: BookingLocale;
  url: string;
}

const { lang, url } = Astro.props;
const content = bookingContent[lang];
const faqs = getFaqsForPage(`booking-${lang}`);
const mailto = bookingMailto(lang);
---

<section id="facts" class="py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.labels.factSheet}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.bio.lead}</p>
    <dl class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {content.facts.map((fact) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <dt class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">{fact.label}</dt>
          <dd class="mt-2 text-sm font-medium leading-relaxed">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section id="bio" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid gap-10 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <h2 class="font-play text-3xl sm:text-4xl font-bold mb-6">{content.bio.title}</h2>
      <div class="space-y-4 text-[var(--color-text-muted)] leading-relaxed">
        {content.bio.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <aside id="press-bio" class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 h-fit">
      <h3 class="font-play text-xl font-bold mb-3">{content.labels.press}</h3>
      <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{content.bio.pressBio}</p>
      <button
        type="button"
        class="mt-5 inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
        data-copy-bio={content.bio.pressBio}
        data-copy-label={content.labels.copyBio}
        data-copied-label={content.labels.bioCopied}
      >
        <Icon name="copy" class="h-4 w-4" />
        <span data-copy-bio-label>{content.labels.copyBio}</span>
      </button>
    </aside>
  </div>
</section>

<section id="genres" class="py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.genres.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.genres.description}</p>
    <div class="grid gap-4 md:grid-cols-3">
      {content.genres.groups.map((group) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <h3 class="font-play text-xl font-bold mb-4">{group.title}</h3>
          <ul class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1.5 text-sm text-[var(--color-text-muted)]">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="references" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.references.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.references.description}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {content.references.items.map((item) => (
        <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
          <h3 class="font-play text-lg font-bold">{item.name}</h3>
          <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-text-muted)]">{item.meta}</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-2">
      {content.trust.map((name) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] px-3 py-1.5 text-sm text-[var(--color-text-muted)]">
          <Icon name="check" class="h-4 w-4 text-[var(--color-primary)]" />
          {name}
        </span>
      ))}
    </div>
  </div>
</section>

<SocialStats
  lang={lang}
  title={content.stats.title}
  description={content.stats.description}
  followersLabel={content.stats.followersLabel}
  updatedLabel={content.stats.updatedLabel}
  note={content.stats.note}
/>

<section id="formats" class="py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.formats.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.formats.description}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {content.formats.items.map((item) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-primary)]/15 text-[var(--color-primary)]">
            <Icon name="party" class="h-5 w-5" />
          </div>
          <h3 class="font-play text-lg font-bold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
          {item.link && (
            <a
              href={item.link}
              target="_blank"
              rel="noopener"
              class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]"
            >
              {item.linkLabel}
              <Icon name="arrow-up" class="h-3.5 w-3.5" />
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<section id="rider" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.rider.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.rider.description}</p>
    <div class="grid gap-4 lg:grid-cols-3">
      {content.rider.groups.map((group, index) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
          <div class="mb-4 flex items-center gap-3">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-primary)]/15 text-sm font-bold text-[var(--color-primary)]">
              {index + 1}
            </span>
            <h3 class="font-play text-lg font-bold">{group.title}</h3>
          </div>
          <ul class="space-y-2.5">
            {group.items.map((item) => (
              <li class="flex gap-3 text-sm text-[var(--color-text-muted)]">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-primary)]" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-[var(--color-text-muted)]">{content.rider.note}</p>
  </div>
</section>

<section id="press" class="py-16 sm:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between mb-10">
      <div class="max-w-3xl">
        <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.press.title}</h2>
        <p class="text-[var(--color-text-muted)] text-lg">{content.press.description}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={content.press.pdfHref}
          download
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-hover)]"
        >
          <Icon name="download" class="h-4 w-4" />
          {content.press.pdfLabel}
        </a>
        <button
          type="button"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
          data-print-epk
        >
          <Icon name="print" class="h-4 w-4" />
          {content.press.printLabel}
        </button>
      </div>
    </div>

    <h3 class="font-play text-2xl font-bold mb-2">{content.press.photosTitle}</h3>
    <p class="mb-6 text-sm text-[var(--color-text-muted)]">{content.press.photosDescription}</p>
    <PressPhotoGrid photos={content.press.photos} downloadLabel={content.labels.download} />

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {content.press.assets.map((asset) => (
        <a
          href={asset.href}
          class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 transition-colors hover:border-[var(--color-primary)]"
        >
          <span class="flex items-center gap-2 font-medium">
            <Icon name="link" class="h-4 w-4 text-[var(--color-primary)]" />
            {asset.label}
          </span>
          <span class="mt-1 block text-xs text-[var(--color-text-muted)]">{asset.description}</span>
        </a>
      ))}
    </div>
    <p class="mt-4 text-xs text-[var(--color-text-muted)]">{content.press.photoCredits}</p>
  </div>
</section>

<section id="process" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.process.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{content.process.description}</p>
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {content.process.steps.map((step, index) => (
        <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
          <span class="font-play text-3xl font-bold text-[var(--color-primary)]">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 font-play text-lg font-bold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="faq" class="py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.faq.title}</h2>
    <p class="text-[var(--color-text-muted)] text-lg mb-8">{content.faq.description}</p>
    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <summary class="flex cursor-pointer list-none items-center gap-3 font-bold">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-[var(--color-primary)]/15 text-[var(--color-primary)] transition-transform group-open:rotate-90">
              <Icon name="chevron-right" class="h-3 w-3" />
            </span>
            {faq.question}
          </summary>
          <p class="mt-3 pl-9 text-[var(--color-text-muted)]" set:html={faq.answer} />
        </details>
      ))}
    </div>
  </div>
</section>

<section id="contact" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.contact.title}</h2>
      <p class="max-w-2xl text-[var(--color-text-muted)] text-lg mb-8">{content.contact.description}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={mailto}
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-hover)]"
        >
          <Icon name="email" class="h-5 w-5" />
          {content.contact.email}
        </a>
        <a
          href={content.contact.whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
        >
          <Icon name="whatsapp" class="h-5 w-5" />
          WhatsApp
        </a>
        <a
          href={content.contact.phoneHref}
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-5 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
        >
          <Icon name="phone" class="h-4 w-4" />
          {content.contact.phone}
        </a>
      </div>
      <p class="mt-6 flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
        <Icon name="calendar" class="h-4 w-4" />
        {content.contact.responseTime}
      </p>
    </div>

    <aside class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6">
      <h3 class="font-play text-xl font-bold mb-2">{content.labels.contact}</h3>
      <p class="text-sm text-[var(--color-text-muted)]">{content.contact.location}</p>
      <div class="mt-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4">
        <p class="text-xs uppercase tracking-wider text-[var(--color-text-muted)]">{content.labels.priceOnRequest}</p>
        <p class="mt-1 text-sm text-[var(--color-text-muted)]">{content.facts.find((fact) => fact.label === 'Preise' || fact.label === 'Rates')?.value ?? content.labels.priceOnRequest}</p>
      </div>
    </aside>
  </div>
</section>

<section id="share" class="py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{content.share.title}</h2>
    <p class="text-[var(--color-text-muted)] text-lg mb-8">{content.share.description}</p>
    <ShareButtons
      url={url}
      title={content.hero.title}
      text={content.share.text}
      hashtags={content.share.hashtags}
      nativeLabel={content.share.nativeLabel}
      whatsappLabel={content.share.whatsappLabel}
      facebookLabel={content.share.facebookLabel}
      xLabel={content.share.xLabel}
      linkedinLabel={content.share.linkedinLabel}
      emailLabel={content.share.emailLabel}
      pinterestLabel={content.share.pinterestLabel}
      redditLabel={content.share.redditLabel}
      telegramLabel={content.share.telegramLabel}
      tiktokLabel={content.share.tiktokLabel}
      copyLabel={content.share.copyLabel}
      copiedLabel={content.share.copiedLabel}
    />
    <div class="mt-10 border-t border-[var(--color-border)] pt-6">
      <a href="#top" class="inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-secondary)]">
        <Icon name="arrow-up" class="h-4 w-4" />
        {content.labels.backToTop}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('[data-print-epk]').forEach(function (button) {
      button.addEventListener('click', function () {
        window.print();
      });
    });

    document.querySelectorAll('[data-copy-bio]').forEach(function (button) {
      if (button.dataset.copyInitialized) return;
      button.dataset.copyInitialized = 'true';

      button.addEventListener('click', function () {
        var text = button.getAttribute('data-copy-bio');
        var label = button.querySelector('[data-copy-bio-label]');
        if (!text) return;

        navigator.clipboard
          .writeText(text)
          .then(function () {
            if (!label) return;
            label.textContent = button.getAttribute('data-copied-label') || 'Copied';
            window.setTimeout(function () {
              label.textContent = button.getAttribute('data-copy-label') || 'Copy';
            }, 2000);
          })
          .catch(function () {});
      });
    });
  })();
</script>
