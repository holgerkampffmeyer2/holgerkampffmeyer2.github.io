---
import Icon from '../Icon.astro';
import type { BookingContent } from '../../data/booking';

interface Props {
  references: BookingContent['references'];
  trust: string[];
}

const { references, trust } = Astro.props;
---

<section id="references" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{references.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{references.description}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {references.items.map((item) => (
        <article class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
          <h3 class="font-play text-lg font-bold">{item.name}</h3>
          <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-text-muted)]">{item.meta}</p>
          <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">{item.description}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 flex flex-wrap gap-2">
      {trust.map((name) => (
        <span class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] px-3 py-1.5 text-sm text-[var(--color-text-muted)]">
          <Icon name="check" class="h-4 w-4 text-[var(--color-primary)]" />
          {name}
        </span>
      ))}
    </div>
  </div>
</section>