---
import Icon from '../Icon.astro';
import type { BookingContent } from '../../data/booking';
import { getFaqsForPage } from '../../data/faqs';

interface Props {
  faq: BookingContent['faq'];
  lang: 'de' | 'en';
}

const { faq, lang } = Astro.props;
const faqs = getFaqsForPage(`booking-${lang}`);
---

<section id="faq" class="py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{faq.title}</h2>
    <p class="text-[var(--color-text-muted)] text-lg mb-8">{faq.description}</p>
    <div class="space-y-3">
      {faqs.map((faqItem) => (
        <details class="group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-5">
          <summary class="flex cursor-pointer list-none items-center gap-3 font-bold">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded bg-[var(--color-primary)]/15 text-[var(--color-primary)] transition-transform group-open:rotate-90">
              <Icon name="chevron-right" class="h-3 w-3" />
            </span>
            {faqItem.question}
          </summary>
          <p class="mt-3 pl-9 text-[var(--color-text-muted)]" set:html={faqItem.answer} />
        </details>
      ))}
    </div>
  </div>
</section>