---
import type { BookingContent } from '../../data/booking';

interface Props {
  process: BookingContent['process'];
}

const { process } = Astro.props;
---

<section id="process" class="py-16 sm:py-20 bg-[var(--color-surface)]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <h2 class="font-play text-3xl sm:text-4xl font-bold mb-3">{process.title}</h2>
    <p class="max-w-3xl text-[var(--color-text-muted)] text-lg mb-10">{process.description}</p>
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {process.steps.map((step, index) => (
        <li class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)] p-5">
          <span class="font-play text-3xl font-bold text-[var(--color-primary)]">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 font-play text-lg font-bold">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>