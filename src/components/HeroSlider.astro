---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Button {
  text: string;
  href: string;
  class?: string;
}

interface Slide {
  title: string;
  titleTag?: "h1" | "h2";
  description: string;
  category?: string;
  buttons: Button[];
  backgroundImage?: string | ImageMetadata;
  overlayVariant?: 'default' | 'secondary';
  ptClass?: string;
  backgroundPosition?: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
  id?: string;
}

const { slides, interval = 5000, id = "hero" } = Astro.props;
const slidesWithMeta = slides.map(s => ({
  ...s,
  isOptimized: typeof s.backgroundImage !== 'string',
}));
---

  <section id={id} class="hero-slider" data-interval={interval}>
  {slidesWithMeta.map((slide, index) => (
    <div class={`slide ${index === 0 ? "active" : ""}`} data-slide={index}>
      {slide.isOptimized ? (
<Picture
           src={slide.backgroundImage as ImageMetadata}
           formats={['avif', 'webp']}
           alt={slide.title}
           class="hero-bg-img"
           loading={index === 0 ? "eager" : "lazy"}
           fetchpriority={index === 0 ? "high" : "low"}
           widths={[640, 1024, 1920]}
           sizes="100vw"
         />
      ) : (
       <img
         src={slide.backgroundImage as string}
         alt={slide.title}
         class="hero-bg-img"
         width="1920"
         height="1080"
         fetchpriority={index === 0 ? "high" : "low"}
         loading={index === 0 ? "eager" : "lazy"}
       />
      )}
      <div class={`slide-overlay ${slide.overlayVariant === 'secondary' ? 'hero-overlay-secondary' : 'hero-overlay'}`}></div>
      <div class="slide-content">
        <div class="container mx-auto px-4">
          <div class={`max-w-5xl ${slide.ptClass || ""}`}>
            {slide.category && (
              <span
                class="text-[var(--color-primary)] text-lg tracking-widest uppercase"
              >
                {slide.category}
              </span>
            )}
            {slide.titleTag === "h2" ? (
              <h2 class="font-play text-5xl md:text-7xl lg:text-8xl font-bold mb-6 gradient-text">
                {slide.title}
              </h2>
            ) : (
              <h1 class="font-play text-5xl md:text-7xl lg:text-8xl font-bold mb-6 gradient-text">
                {slide.title}
              </h1>
            )}
            <p class="text-[var(--color-text-muted)] text-xl md:text-2xl mb-8 max-w-4xl">
              {slide.description}
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
              {slide.buttons.map((btn) => (
                <a href={btn.href} class={btn.class || "btn-primary"}>{btn.text}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}

  <button class="slider-nav prev" id="slider-prev" aria-label="Vorheriger Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button class="slider-nav next" id="slider-next" aria-label="Nächster Slide">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="slider-dots">
    {slides.map((_, index) => (
      <button class={`slider-dot ${index === 0 ? "active" : ""}`} data-dot={index} aria-label={`Slide ${index + 1}`}></button>
    ))}
  </div>
  <script src="/assets/hero-slider.js" defer is:inline></script>
</section>