---
import labels from '../../data/labels.json';
import { buildTrackLabels } from '../../utils/track-labels.js';
import { renderMobileTracklist } from '../../utils/tracklist-renderer.ts';

interface Props {
  tracks: string[];
  displayMode?: 'table' | 'inline' | 'responsive';
}

const { tracks = [], displayMode = 'table' } = Astro.props;
const trackLabels = buildTrackLabels(labels);
const showLabel = trackLabels.hasAny(tracks);

function splitTrack(track: string) {
  const parts = track.split(' - ');
  const artist = parts[0]?.replace(/,$/, '') || '';
  const title = parts.slice(1).join(' - ').replace(/,$/, '') || track;
  return { artist, title };
}

const isTable = displayMode === 'table';
const isResponsive = displayMode === 'responsive';
const isInline = displayMode === 'inline';
const showTable = isTable || isResponsive;
const showMobile = isResponsive || isInline;
---

{showTable && (
  <div class="hidden lg:block">
    <table class="w-full">
      <thead class="sticky top-0 bg-[var(--color-surface)]">
        <tr class="border-b border-[var(--color-border)]">
          <th class="text-left text-xs text-[var(--color-text-muted)] uppercase tracking-wider py-2">Artist</th>
          <th class="text-left text-xs text-[var(--color-text-muted)] uppercase tracking-wider py-2">Title</th>
          {showLabel && (
            <th class="text-left text-xs text-[var(--color-text-muted)] uppercase tracking-wider py-2">Label</th>
          )}
        </tr>
      </thead>
      <tbody>
        {tracks.map((track: string) => {
          const { artist, title } = splitTrack(track);
          const label = trackLabels.get(track);
          return (
            <tr class="border-b border-[var(--color-border)] last:border-0 hover:bg-[var(--color-bg)] transition-colors">
              <td class="py-2 pr-3 align-top">
                <span class="text-[var(--color-text)] font-semibold text-sm">{artist}</span>
              </td>
              <td class="py-2 align-top">
                <span class="text-[var(--color-text-muted)] text-sm">{title}</span>
              </td>
              {showLabel && (
                <td class="py-2 pl-3 align-top">
                  {label && label.url ? (
                    <a
                      href={label.url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="text-[var(--color-secondary)] hover:underline text-sm"
                    >
                      {label.name}
                    </a>
                  ) : label ? (
                    <span class="text-[var(--color-text-muted)] text-sm">{label.name}</span>
                  ) : (
                    <span class="text-[var(--color-text-muted)] text-sm">—</span>
                  )}
                </td>
              )}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
)}

{showMobile && (
  <div class="lg:hidden">
    <nav class="space-y-2 pt-2 border-t border-[var(--color-border)]" aria-label="Tracklist (mobile view)">
      <div set:html={renderMobileTracklist(tracks, showLabel)} />
    </nav>
  </div>
)}