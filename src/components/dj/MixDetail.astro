---
import Icon from '../Icon.astro';
import TracklistTable from './TracklistTable.astro';
import BookingCTA from './BookingCTA.astro';
import ShareButtons from '../ShareButtons.astro';
import { USECASE_CONFIG } from '../../data/usecase-config';
import type { BlogPostData } from '../../types/blog';
import { formatDate, formatDuration } from '../../utils/format';
import { shareConfig } from '../../utils/share-config';
import type { MixLabelInfo, RelatedMix } from '../../utils/mix-seo.js';
import { labelSlug } from '../../utils/label-slug.js';

interface Props {
  post: BlogPostData;
  isLatest?: boolean;
  showNavigation?: boolean;
  introSentences?: string[];
  relatedMixes?: RelatedMix[];
  topLabels?: MixLabelInfo[];
}

const {
  post,
  isLatest = false,
  showNavigation = true,
  introSentences = [],
  relatedMixes = [],
  topLabels = [],
} = Astro.props;
---

<article class="mix-detail">
  <div class="max-w-4xl mx-auto">
    {/* Tags */}
    {post.tags && post.tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-4">
        {post.tags.map(tag => (
          <span class="px-3 py-1 bg-[var(--color-primary)]/10 rounded-full text-sm text-[var(--color-primary)]">
            {tag}
          </span>
        ))}
      </div>
    )}

    {/* Title */}
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
      <h2 class="font-play text-3xl md:text-4xl lg:text-5xl font-bold gradient-text">
        {post.title}
      </h2>
      {isLatest && (
        <span class="shrink-0 bg-[var(--color-primary)] text-white text-sm px-3 py-1 rounded font-medium self-start">
          Latest Mix
        </span>
      )}
    </div>
    
    {/* Hero Image */}
    {post.heroImage && (
      <div class="mb-6">
        <img src={post.heroImage} alt={post.title} loading="lazy" decoding="async" class="w-full h-48 md:h-64 lg:h-80 object-cover rounded-xl border border-[var(--color-border)]" />
      </div>
    )}

    {/* Date & Duration */}
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6">
      <div class="flex items-center gap-2">
        <span class="text-[var(--color-text-muted)] text-sm">Date:</span>
        <span class="text-[var(--color-primary)] font-medium bg-[var(--color-primary)]/10 px-3 py-1 rounded">
          {post.created_time && formatDate(post.created_time)}
        </span>
      </div>
      {post.audio_length && (
        <div class="flex items-center gap-2">
          <span class="text-[var(--color-text-muted)] text-sm">Mixlength:</span>
          <span class="text-[var(--color-text)] font-medium bg-[var(--color-surface)] px-3 py-1 rounded border border-[var(--color-border)]">
            {formatDuration(post.audio_length)}
          </span>
        </div>
      )}
    </div>

    {/* Intro */}
    {introSentences.length > 0 && (
      <div class="mb-8 max-w-2xl">
        <p class="text-[var(--color-text)] text-lg leading-relaxed">{introSentences[0]}</p>
        {introSentences.length > 1 && (
          <p class="text-[var(--color-text-muted)] leading-relaxed mt-3">{introSentences.slice(1).join(' ')}</p>
        )}
      </div>
    )}

    {/* Description */}
    {post.description && (
      <div class="mb-8 max-w-2xl">
        <h2 class="font-play text-sm font-semibold uppercase tracking-wide text-[var(--color-text-muted)] mb-2">Beschreibung von Mixcloud</h2>
        <p class="text-[var(--color-text-muted)] whitespace-pre-wrap">{post.description}</p>
      </div>
    )}

    {/* Labels in this mix */}
    {topLabels.length > 0 && (
      <div class="mb-8">
        <h2 class="font-play text-sm font-semibold uppercase tracking-wide text-[var(--color-text-muted)] mb-3">Labels in diesem Mix</h2>
        <ul class="flex flex-wrap gap-2">
          {topLabels.map((label) => (
            <li>
              <a
                href={`/dj/labels/${labelSlug(label.name)}`}
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-colors"
              >
                {label.name}
                <span class="text-[var(--color-text-muted)] text-xs">({label.count})</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* Use Cases */}
    {post.useCases && post.useCases.length > 0 && (
      <div class="flex flex-wrap gap-3 mb-8">
        {post.useCases.map(useCase => {
          const config = USECASE_CONFIG[useCase];
          return (
            <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-[var(--color-surface)] rounded-full text-sm border border-[var(--color-border)]">
              {config?.icon && <Icon name={config.icon} class={`w-4 h-4 ${config?.color || ''}`} />}
              <span class="text-[var(--color-text)]">{config?.label || useCase}</span>
            </span>
          );
        })}
      </div>
    )}

    {/* Mixcloud Player */}
    <div class="bg-[var(--color-surface)] rounded-xl overflow-hidden border border-[var(--color-border)] mb-8">
      <div class="p-4 border-b border-[var(--color-border)]">
        <h2 class="font-play text-lg font-bold">Mixcloud Player: Push play directly in your browser!</h2>
      </div>
      <iframe 
        class="iframe-mixcloud"
        src={`${post.src}&hide_tracklist=1`}
        title={post.title}
        allow="encrypted-media; fullscreen; autoplay; idle-detection; web-share;"
        loading="lazy"
      ></iframe>
    </div>

    {/* Booking CTA - Sidebar variant after player */}
    <BookingCTA variant="sidebar" class="mb-8" />

    {/* Tracklist */}
    {post.tracklist && post.tracklist.length > 0 && (
      <div class="bg-[var(--color-surface)] rounded-xl overflow-hidden border border-[var(--color-border)] mb-8">
        <div class="p-4 border-b border-[var(--color-border)]">
          <h2 class="font-play text-lg font-bold">Tracklist ({post.tracklist.length} Tracks)</h2>
        </div>
        <div class="p-4 max-h-[500px] overflow-y-auto">
          <TracklistTable tracks={post.tracklist} displayMode="responsive" />
        </div>
      </div>
    )}

    {/* Related mixes */}
    {relatedMixes.length > 0 && (
      <div class="mb-8">
        <h2 class="font-play text-lg font-bold mb-4">Ähnliche Mixes</h2>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedMixes.map((mix) => (
            <a
              href={mix.href}
              class="flex flex-col gap-1 p-4 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-primary)] transition-colors"
            >
              <span class="font-medium text-[var(--color-text)] text-sm">{mix.title}</span>
              <span class="text-xs text-[var(--color-text-muted)]">{mix.reason}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* Listen on Mixcloud */}
    {post.url && showNavigation && (
      <div class="flex flex-wrap gap-4 mb-8">
        <a href={post.url} target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--color-surface)] rounded-lg border border-[var(--color-border)] hover:border-[var(--color-secondary)] transition-colors text-[var(--color-text-muted)] hover:text-[var(--color-secondary)]">
          <Icon name="mixcloud" class="w-5 h-5" />
          <span>Listen on Mixcloud</span>
        </a>
      </div>
    )}

    {/* Share this mix */}
    <ShareButtons
      url={`https://holger-kampffmeyer.de/dj/mixes/${post.slug}`}
      title={post.title}
      text={post.description?.substring(0, 200) || `DJ Hulk Mix: ${post.title}`}
      hashtags="DJHulk,TechHouse,House,ElectronicMusic"
      config={shareConfig.mixDetail.de}
    />
  </div>
</article>