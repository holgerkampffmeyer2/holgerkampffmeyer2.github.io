---
import Icon from './Icon.astro';
import { buildShareLinks } from '../utils/share';
import type { ShareConfigPreset } from '../utils/share-config';

interface Props {
  url: string;
  title: string;
  text: string;
  hashtags?: string;
  nativeLabel?: string;
  whatsappLabel?: string;
  facebookLabel?: string;
  xLabel?: string;
  linkedinLabel?: string;
  emailLabel?: string;
  pinterestLabel?: string;
  redditLabel?: string;
  telegramLabel?: string;
  copyLabel?: string;
  copiedLabel?: string;
  config?: ShareConfigPreset;
}

const {
  url,
  title,
  text,
  hashtags,
  nativeLabel,
  whatsappLabel,
  facebookLabel,
  xLabel,
  linkedinLabel,
  emailLabel,
  pinterestLabel,
  redditLabel,
  telegramLabel,
  copyLabel,
  copiedLabel,
  config,
} = Astro.props;

const labels = config
  ? {
      nativeLabel: config.nativeLabel,
      whatsappLabel: config.whatsappLabel,
      facebookLabel: config.facebookLabel,
      xLabel: config.xLabel,
      linkedinLabel: config.linkedinLabel,
      emailLabel: config.emailLabel,
      pinterestLabel: config.pinterestLabel,
      redditLabel: config.redditLabel,
      telegramLabel: config.telegramLabel,
      copyLabel: config.copyLabel,
      copiedLabel: config.copiedLabel,
    }
  : {
      nativeLabel: nativeLabel!,
      whatsappLabel: whatsappLabel!,
      facebookLabel: facebookLabel!,
      xLabel: xLabel!,
      linkedinLabel: linkedinLabel!,
      emailLabel: emailLabel!,
      pinterestLabel: pinterestLabel!,
      redditLabel: redditLabel!,
      telegramLabel: telegramLabel!,
      copyLabel: copyLabel!,
      copiedLabel: copiedLabel!,
    };

const links = buildShareLinks({ url, title, text, hashtags });
---

<div class="flex flex-wrap gap-3" data-share-root data-share-url={url} data-share-title={title} data-share-text={text}>
  <button
    type="button"
    class="hidden inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-primary-hover)]"
    data-native-share
  >
    <Icon name="share" class="h-4 w-4" />
    {labels.nativeLabel}
  </button>

  <a
    href={links.whatsapp}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="whatsapp" class="h-5 w-5" />
    {labels.whatsappLabel}
  </a>

  <a
    href={links.facebook}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="facebook" class="h-5 w-5" />
    {labels.facebookLabel}
  </a>

  <a
    href={links.x}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="x" class="h-5 w-5" />
    {labels.xLabel}
  </a>

  <a
    href={links.linkedin}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="linkedin" class="h-5 w-5" />
    {labels.linkedinLabel}
  </a>

  <a
    href={links.pinterest}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="pinterest" class="h-5 w-5" />
    {labels.pinterestLabel}
  </a>

  <a
    href={links.reddit}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="reddit" class="h-5 w-5" />
    {labels.redditLabel}
  </a>

  <a
    href={links.telegram}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="telegram" class="h-5 w-5" />
    {labels.telegramLabel}
  </a>

  <a
    href={links.email}
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
  >
    <Icon name="email" class="h-5 w-5" />
    {labels.emailLabel}
  </a>

  <button
    type="button"
    class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] px-4 py-2.5 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:border-[var(--color-primary)] hover:text-[var(--color-secondary)]"
    data-copy-url={url}
    data-copy-label={labels.copyLabel}
    data-copied-label={labels.copiedLabel}
  >
    <Icon name="copy" class="h-4 w-4" />
    <span data-copy-text>{labels.copyLabel}</span>
  </button>
</div>

<script is:inline>
  (function () {
    var roots = document.querySelectorAll('[data-share-root]');
    roots.forEach(function (root) {
      if (root.dataset.shareInitialized) return;
      root.dataset.shareInitialized = 'true';

      var nativeButton = root.querySelector('[data-native-share]');
      var copyButton = root.querySelector('[data-copy-url]');

      if (nativeButton && navigator.share) {
        nativeButton.classList.remove('hidden');
        nativeButton.addEventListener('click', function () {
          navigator
            .share({
              title: root.dataset.shareTitle,
              text: root.dataset.shareText,
              url: root.dataset.shareUrl,
            })
            .catch(function () {});
        });
      }

      if (copyButton) {
        copyButton.addEventListener('click', function () {
          var url = copyButton.getAttribute('data-copy-url');
          var label = copyButton.querySelector('[data-copy-text]');
          if (!url) return;

          navigator.clipboard
            .writeText(url)
            .then(function () {
              if (!label) return;
              label.textContent = copyButton.getAttribute('data-copied-label') || 'Copied';
              window.setTimeout(function () {
                label.textContent = copyButton.getAttribute('data-copy-label') || 'Copy';
              }, 2000);
            })
            .catch(function () {});
        });
      }
    });
  })();
</script>